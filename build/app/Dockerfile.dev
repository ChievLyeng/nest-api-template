FROM node:22-alpine

WORKDIR /app

# Install deps first (better caching)
COPY package*.json ./
RUN npm install

# Copy source
COPY . .

RUN npx prisma generate

COPY build/scripts/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

RUN apk add --no-cache bash

# Expose NestJS port
EXPOSE 3000

ENTRYPOINT ["/bin/bash", "/entrypoint.sh"]
CMD ["app:start"]